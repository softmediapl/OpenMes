# Copy these values into Portainer Stack > Environment variables.
# Do not commit a filled production copy.

STACK_NAME=openmes

# Public address. DOMAIN must resolve to the server before Nginx Proxy Manager can issue TLS.
DOMAIN=mes.example.com
APP_URL=https://mes.example.com

# Existing Docker network used by the Nginx Proxy Manager container.
# Check on the server with: docker network ls
NPM_NETWORK=devops_net

# Build output tag used inside the stack.
OPENMES_IMAGE=softmedia/openmes
OPENMES_IMAGE_TAG=local

# Generate once and keep stable. Example:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:CHANGE_ME

# Database credentials.
POSTGRES_DB=openmes
POSTGRES_USER=openmes_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# First admin account. Used only when the database has no users.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Reverb: REVERB_APP_KEY is public and currently compiled into the frontend.
REVERB_APP_ID=openmes
REVERB_APP_KEY=openmeskey
REVERB_APP_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Optional, useful when users access the app by additional LAN hostnames/IPs.
SANCTUM_STATEFUL_DOMAINS=

# Backups.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
